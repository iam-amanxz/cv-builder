{
    "name": "cv-builder",
    "private": true,
    "type": "module",
    "imports": {
        "#/*": "./src/*"
    },
    "scripts": {
        "dev": "vite dev --port 3000",
        "generate-routes": "vite build",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint",
        "format": "prettier --write . && eslint --fix",
        "check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "db:generate": "drizzle-kit generate",
        "docker:up": "docker compose up -d --build",
        "docker:logs": "docker compose logs -f cv"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^1.5.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource/ibm-plex-sans": "^5.3.0",
        "@fontsource/lora": "^5.3.0",
        "@fontsource/source-serif-4": "^5.3.1",
        "@tailwindcss/vite": "^4.1.18",
        "@tanstack/react-devtools": "0.10.14",
        "@tanstack/react-form": "1.33.5",
        "@tanstack/react-query": "5.106.1",
        "@tanstack/react-query-devtools": "5.106.1",
        "@tanstack/react-router": "1.170.46",
        "@tanstack/react-router-devtools": "1.167.2",
        "@tanstack/react-router-ssr-query": "1.167.3",
        "@tanstack/react-start": "1.169.4",
        "better-sqlite3": "^13.0.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "docx": "^9.15.2",
        "drizzle-orm": "^0.45.4",
        "lucide-react": "^0.577.0",
        "mammoth": "^1.13.0",
        "nanoid": "^6.0.2",
        "nitro": "3.0.260610-beta",
        "playwright": "^1.64.1",
        "radix-ui": "^1.8.1",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "tailwind-merge": "^3.0.2",
        "tailwindcss": "^4.1.18",
        "tw-animate-css": "^1.3.6",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@tailwindcss/typography": "^0.5.16",
        "@tanstack/devtools-vite": "0.8.6",
        "@tanstack/eslint-config": "0.4.0",
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^22.10.2",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.0.1",
        "drizzle-kit": "^0.31.11",
        "eslint": "^9.20.0",
        "prettier": "^3.8.1",
        "typescript": "^6.0.2",
        "vite": "^8.0.0"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "lightningcss"
        ]
    }
}
